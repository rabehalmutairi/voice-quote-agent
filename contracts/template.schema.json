{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rabehalmutairi/voice-quote-agent/contracts/template.schema.json",
  "title": "Category template",
  "description": "Shape of every /templates/<category>.yaml file. Everything category-specific lives in a template, not in engine code (architecture §2, §7). Cross-references (every key used below is defined in `fields`) are checked in tests/contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "planner_questions",
    "fields",
    "offer_fields",
    "quote_fields",
    "call_questions",
    "required_fields",
    "compare_on",
    "asr_keywords",
    "places_queries"
  ],
  "properties": {
    "category": { "$ref": "common.schema.json#/$defs/name" },
    "planner_questions": {
      "type": "array",
      "minItems": 1,
      "description": "Asked to the USER before any call. The answer to `area` fills TaskSpec.area; every other answer fills TaskSpec.slots.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "ask_ar"],
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/name" },
          "ask_ar": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "description": "Every value the agent tries to collect. `type` tells extraction what to produce; `choice` values must come from `choices`.",
      "propertyNames": { "$ref": "common.schema.json#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "enum": ["number", "choice", "text", "boolean"] },
          "unit": { "type": "string", "minLength": 1 },
          "choices": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/name" }
          }
        },
        "if": { "properties": { "type": { "const": "choice" } } },
        "then": { "required": ["choices"] },
        "else": { "not": { "required": ["choices"] } }
      }
    },
    "offer_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" },
      "description": "Fields that can differ per option the shop quotes: they go inside each entry of Quote.offers."
    },
    "quote_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" },
      "description": "Fields that apply to the whole call: they go in Quote.fields."
    },
    "call_questions": {
      "type": "array",
      "minItems": 1,
      "description": "Asked by the AGENT on the call, one at a time. {{slot}} placeholders come from CallJob.dynamic_variables.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "ask_ar"],
        "properties": {
          "field": { "$ref": "common.schema.json#/$defs/name" },
          "ask_ar": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" }
    },
    "compare_on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" },
      "description": "Offer fields shops are compared on, like for like."
    },
    "asr_keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "places_queries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
