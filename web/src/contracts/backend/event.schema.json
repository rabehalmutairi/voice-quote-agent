{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rabehalmutairi/voice-quote-agent/contracts/event.schema.json",
  "title": "Event",
  "description": "Backend -> UI over Server-Sent Events. `type` decides the shape of `data`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "type", "task_id", "at", "data"],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-task counter starting at 1, sent as the SSE event id so the UI can resume after a reconnect."
    },
    "type": {
      "enum": [
        "task.created",
        "task.needs_input",
        "business.found",
        "call.started",
        "call.ended",
        "call.failed",
        "quote.ready",
        "comparison.ready",
        "task.failed"
      ]
    },
    "task_id": { "$ref": "common.schema.json#/$defs/task_id" },
    "at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "task.created" } } },
      "then": { "properties": { "data": { "$ref": "task_spec.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.needs_input" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/needs_input" } } }
    },
    {
      "if": { "properties": { "type": { "const": "business.found" } } },
      "then": { "properties": { "data": { "$ref": "business.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "call.started" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/call_started" } } }
    },
    {
      "if": { "properties": { "type": { "const": "call.ended" } } },
      "then": {
        "properties": {
          "data": {
            "$ref": "call_result.schema.json",
            "properties": { "outcome": { "enum": ["human_completed", "human_partial"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "call.failed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/call_failed" } } }
    },
    {
      "if": { "properties": { "type": { "const": "quote.ready" } } },
      "then": { "properties": { "data": { "$ref": "quote.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "comparison.ready" } } },
      "then": { "properties": { "data": { "$ref": "comparison.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.failed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/task_failed" } } }
    }
  ],
  "$defs": {
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "ask_ar"],
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/name" },
              "ask_ar": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "call_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "place_id"],
      "properties": {
        "call_id": { "$ref": "common.schema.json#/$defs/call_id" },
        "place_id": { "$ref": "common.schema.json#/$defs/place_id" }
      }
    },
    "call_failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "place_id", "outcome", "reason"],
      "properties": {
        "call_id": { "$ref": "common.schema.json#/$defs/call_id" },
        "place_id": { "$ref": "common.schema.json#/$defs/place_id" },
        "outcome": {
          "enum": ["voicemail", "ivr", "no_answer", "busy", "hung_up", "wrong_business", "failed"],
          "description": "Calls that reached a human end with call.ended instead."
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "task_failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
